<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Force a DEDICATED MariaDB test database, SEPARATE from rgadmin's
             `mc_rg_test`: both apps create the cus_* tables (rgugyfel via its own
             migrations, rgadmin via a guarded fallback migration), so sharing one
             test DB makes their migrate:fresh runs collide. Each app owns its own.
             force="true" so a stray shell env var cannot point at the live mc_rg;
             the guard in tests/TestCase.php refuses any DB not ending in _test.
             (SQLite is not available on the host PHP.) One-time host setup:
               CREATE DATABASE mc_rg_cp_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
               GRANT ALL PRIVILEGES ON mc_rg_cp_test.* TO 'mcdev'@'localhost'; -->
        <env name="DB_CONNECTION" value="mariadb" force="true"/>
        <env name="DB_DATABASE" value="mc_rg_cp_test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="RECAPTCHA_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
