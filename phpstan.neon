includes:
	- vendor/larastan/larastan/extension.neon
	- phpstan-baseline.neon

parameters:
	# Level 6 (matches rgadmin). Any pre-existing level-6 findings are frozen in
	# phpstan-baseline.neon - after `composer require --dev larastan/larastan`
	# regenerate it once with `composer stan:baseline`, then commit it. Raise the
	# level over time (bump level, regenerate baseline).
	level: 6

	paths:
		- app
		- config
		- database
		- routes
		- tests
